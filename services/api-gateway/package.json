{
  "name": "@enterprise/api-gateway",
  "version": "1.0.0",
  "description": "Enterprise API Gateway for microservices routing, rate limiting, and security",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
