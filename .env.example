# ========================================================
# Enterprise Masterpiece Platform - Environment Config
# ========================================================

# Global Environment
NODE_ENV=development
LOG_LEVEL=info
PORT_GATEWAY=4000
PORT_AUTH=4001
PORT_USER=4002
PORT_PRODUCT=4003
PORT_ORDER=4004
PORT_FRONTEND=3000

# Gateway Microservice Routes
AUTH_SERVICE_URL=http://localhost:4001
USER_SERVICE_URL=http://localhost:4002
PRODUCT_SERVICE_URL=http://localhost:4003
ORDER_SERVICE_URL=http://localhost:4004

# Security & Secrets
JWT_SECRET=super-secret-jwt-key-change-in-production-2026-auth
JWT_REFRESH_SECRET=super-secret-refresh-key-change-in-production-2026-auth
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000

# Databases
AUTH_DB_URI=mongodb://localhost:27017/auth_db
USER_DB_URI=mongodb://localhost:27017/user_db
PRODUCT_DB_URI=mongodb://localhost:27017/product_db
ORDER_DB_URI=mongodb://localhost:27017/order_db
REDIS_URI=redis://localhost:6379

# Monitoring
METRICS_ENABLED=true
